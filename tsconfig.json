{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"sourceMap": true,
		"noEmit": true,
		"types": ["vite/client", "bun-types"],
		"paths": { "$lib/*": ["./src/lib/*"] }
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"vite.config.ts",
		"drizzle.config.ts",
		"playwright.config.ts"
	],
	"exclude": ["node_modules", "dist", "build", "src/lib/paraglide"]
}
