{
	"name": "ace-blocker-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"setup": "bun scripts/setup.ts",
		"setup-env": "bun scripts/setup-env.ts",
		"gen:entitlement-keys": "bun scripts/generate-entitlement-keys.ts",
		"provision-admin": "bun scripts/provision-admin.ts",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url baseLocale",
		"prepare": "svelte-kit sync || echo ''",
		"seo:audit": "bun scripts/seo-audit.ts",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "bun run paraglide:compile && svelte-kit sync && prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright test",
		"verify-screenshots": "bun scripts/verify-screenshots.ts",
		"db:start": "docker compose up",
		"db:delete": "bun scripts/delete-db.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"gen:auth-schema": "bun x auth@1.7.5 generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.65.0",
		"@ninoseki/eslint-plugin-neverthrow": "^0.3.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@typescript-eslint/parser": "^8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"devcert-sanscache": "^0.5.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"layerchart": "^2.9.1",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.14",
		"@better-auth/core": "^1.7.14",
		"@bunny.net/storage-sdk": "^0.3.2",
		"@dodopayments/better-auth": "^1.6.6",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/openapi": "^1.4.16",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-sans-condensed": "^5.3.0",
		"@sinclair/typebox": "^0.34.52",
		"@tabler/icons-svelte": "^3.50.0",
		"better-auth": "^1.7.14",
		"dodopayments": "^2.59.0",
		"dodopayments-checkout": "^2.0.1",
		"dotenv": "^18.0.9",
		"elysia": "^1.4.30",
		"lru-cache": "^11.5.3",
		"mode-watcher": "^1.1.0",
		"neverthrow": "^8.2.0",
		"pino": "^10.4.0",
		"postgres": "^3.4.9",
		"resend": "^6.34.1",
		"svelte-sonner": "^1.2.2",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	}
}
