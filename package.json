{
	"name": "ace-blocker-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"setup": "bun scripts/setup.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:delete": "bun scripts/delete-db.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "~9.39.3",
		"@eslint/compat": "~1.4.1",
		"@inlang/paraglide-js": "~2.13.0",
		"@internationalized/date": "~3.11.0",
		"@lucide/svelte": "~0.561.0",
		"@playwright/test": "~1.58.2",
		"@sveltejs/adapter-node": "~5.5.4",
		"@sveltejs/kit": "~2.53.4",
		"@sveltejs/vite-plugin-svelte": "~6.2.4",
		"@tailwindcss/forms": "~0.5.11",
		"@tailwindcss/typography": "~0.5.19",
		"@tailwindcss/vite": "~4.2.1",
		"@types/node": "~24.11.0",
		"@vitest/browser-playwright": "~4.0.18",
		"bits-ui": "~2.16.2",
		"clsx": "~2.1.1",
		"devcert-sanscache": "~0.5.1",
		"drizzle-kit": "~0.31.9",
		"drizzle-orm": "~0.45.1",
		"eslint": "~9.39.3",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-svelte": "~3.15.0",
		"globals": "~16.5.0",
		"playwright": "~1.58.2",
		"prettier": "~3.8.1",
		"prettier-plugin-svelte": "~3.5.0",
		"prettier-plugin-tailwindcss": "~0.7.2",
		"svelte": "~5.53.6",
		"svelte-check": "~4.4.4",
		"tailwind-merge": "~3.5.0",
		"tailwind-variants": "~3.2.2",
		"tailwindcss": "~4.2.1",
		"tw-animate-css": "~1.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "~8.56.1",
		"vite": "~7.3.1",
		"vitest": "~4.0.18",
		"vitest-browser-svelte": "~2.0.2"
	},
	"dependencies": {
		"@dodopayments/better-auth": "~1.4.2",
		"@elysiajs/eden": "~1.4.8",
		"@elysiajs/openapi": "~1.4.14",
		"@sinclair/typebox": "~0.34.48",
		"@tabler/icons-svelte": "~3.37.1",
		"better-auth": "1.4.20",
		"dodopayments": "~2.21.0",
		"dotenv": "~17.3.1",
		"elysia": "~1.4.26",
		"mode-watcher": "~1.1.0",
		"openapi-merge": "~1.3.3",
		"postgres": "~3.4.8",
		"resend": "~6.9.3",
		"uuid": "~13.0.0",
		"zod": "~4.3.6"
	}
}
