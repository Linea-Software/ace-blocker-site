{
	"name": "ace-blocker-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"setup": "bun scripts/setup.ts",
		"setup-env": "bun scripts/setup-env.ts",
		"gen:entitlement-keys": "bun scripts/generate-entitlement-keys.ts",
		"provision-admin": "bun scripts/provision-admin.ts",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url baseLocale",
		"prepare": "bun run paraglide:compile",
		"seo:audit": "bun scripts/seo-audit.ts",
		"check": "bun run paraglide:compile && tsc --noEmit --pretty false",
		"check:watch": "bun run paraglide:compile && tsc --noEmit --watch",
		"format": "prettier --write .",
		"lint": "bun run paraglide:compile && prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "bun --no-env-file scripts/e2e/run.ts",
		"verify-screenshots": "bun run test:e2e -- e2e/visual-routes.spec.ts",
		"db:start": "bun scripts/db.ts start",
		"db:delete": "bun scripts/db.ts delete",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/guard-db-migrate.ts && drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"gen:auth-schema": "bun x auth@1.7.5 generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.3",
		"@internationalized/date": "^3.12.4",
		"@ninoseki/eslint-plugin-neverthrow": "^0.3.2",
		"@playwright/test": "^1.64.1",
		"@solidjs/babel-plugin": "^2.0.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@typescript-eslint/parser": "^8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^5.0.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.27",
		"@better-auth/core": "^1.7.27",
		"@bunny.net/storage-sdk": "^0.3.2",
		"@dodopayments/better-auth": "^1.6.6",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/openapi": "^1.4.16",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-sans-condensed": "^5.3.0",
		"@lucide/solid": "^1.78.0",
		"@sinclair/typebox": "^0.34.52",
		"@solidjs/meta": "^2.0.0",
		"@solidjs/router": "^2",
		"@solidjs/vite-plugin": "^3.0.1",
		"@solidjs/web": "^2",
		"better-auth": "^1.7.27",
		"dodopayments": "^2.59.0",
		"dodopayments-checkout": "^2.0.1",
		"dotenv": "^18.0.9",
		"elysia": "^1.4.30",
		"filesystem-routing": "^0.5.0",
		"lru-cache": "^11.5.3",
		"neverthrow": "^8.2.0",
		"pino": "^10.4.0",
		"postgres": "^4.0.0",
		"resend": "^6.37.0",
		"solid-js": "^2",
		"uuid": "^14.0.3",
		"zod": "^4.6.7",
		"drizzle-orm": "^0.45.4"
	}
}
