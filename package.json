{
	"name": "ace-blocker-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"setup": "bun scripts/setup.ts",
		"setup-env": "bun scripts/setup-env.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:delete": "bun scripts/delete-db.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"gen:auth-schema": "bun x auth@latest generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.38.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@typescript-eslint/parser": "^8.68.0",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"devcert-sanscache": "^0.5.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-neverthrow": "^1.1.4",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.2",
		"@better-auth/core": "^1.7.2",
		"@bunny.net/storage-sdk": "^0.3.1",
		"@dodopayments/better-auth": "^1.6.6",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/openapi": "^1.4.15",
		"@sinclair/typebox": "^0.34.52",
		"@tabler/icons-svelte": "^3.46.0",
		"better-auth": "^1.7.2",
		"dodopayments": "^2.48.0",
		"dotenv": "^17.4.2",
		"elysia": "^1.4.30",
		"lru-cache": "^11.5.2",
		"mode-watcher": "^1.1.0",
		"neverthrow": "^8.2.0",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"resend": "^6.25.0",
		"svelte-sonner": "^1.2.1",
		"uuid": "^14.0.2",
		"zod": "^4.5.4"
	}
}
