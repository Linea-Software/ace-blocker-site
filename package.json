{
	"name": "ace-blocker-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"setup": "bun scripts/setup.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:delete": "bun scripts/delete-db.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"gen:auth-schema": "bun x auth@latest generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.3",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.13",
		"@types/node": "^25.6.0",
		"@typescript-eslint/parser": "^8.58.1",
		"@vitest/browser-playwright": "^4.1.4",
		"bits-ui": "^2.17.3",
		"clsx": "^2.1.1",
		"devcert-sanscache": "^0.5.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-neverthrow": "^1.1.4",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.8",
		"vitest": "^4.1.4",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.11",
		"@bunny.net/storage-sdk": "^0.3.1",
		"@dodopayments/better-auth": "^1.6.3",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/openapi": "^1.4.14",
		"@sinclair/typebox": "^0.34.49",
		"@tabler/icons-svelte": "^3.41.1",
		"better-auth": "^1.6.2",
		"dodopayments": "^2.27.0",
		"dotenv": "^17.4.1",
		"elysia": "^1.4.28",
		"lru-cache": "^11.3.3",
		"mode-watcher": "^1.1.0",
		"neverthrow": "^8.2.0",
		"postgres": "^3.4.9",
		"resend": "^6.10.0",
		"uuid": "^13.0.0",
		"zod": "^4.3.6"
	}
}
